---
import ToolHub from "../components/ToolHub";
import { SITE_SEO } from "../seo";
import { getHomeSchemas } from "../lib/seo";
import "../index.css";

const homeSchemas = getHomeSchemas();
const canonicalUrl = "https://tools.sattaspace.com/";
---

<!doctype html>
<html lang="en" class="h-full bg-slate-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Core SEO Meta Tags -->
    <title>{SITE_SEO.title}</title>
    <meta name="description" content={SITE_SEO.description} />
    <meta name="keywords" content={SITE_SEO.keywords.join(", ")} />
    <meta name="author" content={SITE_SEO.author} />
    <meta name="robots" content="index, follow" />
    <meta name="language" content={SITE_SEO.language} />

    <!-- OpenGraph Social Metadata -->
    <meta property="og:title" content={SITE_SEO.title} />
    <meta property="og:description" content={SITE_SEO.description} />
    <meta property="og:type" content={SITE_SEO.ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={SITE_SEO.ogImage} />
    <meta property="og:site_name" content={SITE_SEO.shortTitle} />

    <!-- Twitter Social Metadata -->
    <meta name="twitter:card" content={SITE_SEO.twitterCard} />
    <meta name="twitter:title" content={SITE_SEO.title} />
    <meta name="twitter:description" content={SITE_SEO.description} />
    <meta name="twitter:image" content={SITE_SEO.ogImage} />
    {
      SITE_SEO.twitterCreator && (
        <meta name="twitter:creator" content={SITE_SEO.twitterCreator} />
      )
    }

    <!-- Canonical Tag with Trailing Slash -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- JSON-LD Structured Data for Search (SEO), Answer Engines (AEO), and LLM Knowledge Graphs (GEO) -->
    {
      homeSchemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Static Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />

    <!-- Google AdSense Script Integration -->
    {
      SITE_SEO.adsense.enabled && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE_SEO.adsense.client}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body class="h-full m-0 p-0 antialiased font-sans select-none">
    <ToolHub client:load />
  </body>
</html>