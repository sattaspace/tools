# ==============================================================================
# SattaSpace Tools - Environment Configuration Template
# Synchronized with wrangler.jsonc (Cloudflare Workers) and Astro client environment
# ==============================================================================

# Site URL Configuration
# Used for canonical URLs, OpenGraph image resolution, sitemap, and internal links.
SITE="https://tools.sattaspace.com"
APP_URL="https://tools.sattaspace.com"
PUBLIC_SITE_URL="https://tools.sattaspace.com"

# Google AdSense Configuration
# Configure publisher credentials and toggle ad delivery.
# In testMode, non-intrusive sandbox placeholders are rendered for layout validation.
GOOGLE_ADSENSE_CLIENT="ca-pub-1234567890123456"
PUBLIC_ADSENSE_CLIENT="ca-pub-1234567890123456"

GOOGLE_ADSENSE_ENABLED="false"
PUBLIC_ADSENSE_ENABLED="false"

GOOGLE_ADSENSE_TEST_MODE="true"
PUBLIC_ADSENSE_TEST_MODE="true"

# Google AdSense Ad Slots
# Slot identifiers configured in Google AdSense management console
GOOGLE_ADSENSE_SLOT_SIDEBAR="8472910531"
PUBLIC_ADSENSE_SLOT_SIDEBAR="8472910531"

GOOGLE_ADSENSE_SLOT_FOOTER="9312847502"
PUBLIC_ADSENSE_SLOT_FOOTER="9312847502"

GOOGLE_ADSENSE_SLOT_MIDCONTENT="1057391823"
PUBLIC_ADSENSE_SLOT_MIDCONTENT="1057391823"

# Optional AI Studio / Gemini Integration
# Required if leveraging server-side Google GenAI features
GEMINI_API_KEY=""
